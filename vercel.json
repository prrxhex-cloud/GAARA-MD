{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://gaara-md-cf37.onrender.com/api/:path*" },
    { "source": "/health", "destination": "https://gaara-md-cf37.onrender.com/health" },
    { "source": "/ping", "destination": "https://gaara-md-cf37.onrender.com/ping" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/reviews", "destination": "/reviews.html" },
    { "source": "/settings", "destination": "/settings.html" },
    { "source": "/pair", "destination": "/pair.html" },
    { "source": "/status", "destination": "/status.html" },
    { "source": "/support", "destination": "/support.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/cookies", "destination": "/cookies.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, x-panel-token" }
      ]
    }
  ]
}
